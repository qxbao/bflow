{
  "environment": {
    "herdrBinary": "herdr",
    "roles": [
      {
        "role": "conversation",
        "cli": "codex",
        "required": true
      },
      {
        "role": "coordinator",
        "cli": "codex",
        "required": true
      },
      {
        "role": "planner",
        "cli": "codex",
        "required": true
      },
      {
        "role": "architect",
        "cli": "codex",
        "required": true
      },
      {
        "role": "specifier",
        "cli": "codex",
        "required": true
      },
      {
        "role": "reviewer",
        "cli": "codex",
        "required": true
      },
      {
        "role": "qa",
        "cli": "codex",
        "required": true
      }
    ],
    "sdd": {
      "minimumLevel": "lightweight",
      "approvalRequired": true
    },
    "tdd": {
      "policy": "conditional"
    },
    "verification": {
