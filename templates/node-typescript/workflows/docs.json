{
  "schemaVersion": "1",
  "id": "portable-docs",
  "name": "Portable Node docs",
  "version": "1.0.0",
  "description": "P19 Developer DAG seed: Document safe integer limits. Host supplies independent checks and approval authentication.",
  "tasks": [
    {
      "id": "docs-change",
      "title": "Document safe integer limits",
      "role": "developer",
      "instruction": "Document safe integer limits. Work only within owned paths and satisfy docs-1. Follow the accepted specification and resolved TestStrategy.",
      "acceptanceCriteria": [
        "docs-1"
      ],
      "retry": {
        "maxAttempts": 2,
        "strategy": "fixed",
        "initialDelayMs": 1000,
        "maxDelayMs": 1000,
        "jitter": false
      },
      "rework": {
        "maxReworks": 2,
        "onExhausted": "require_human"
      },
      "timeout": {
        "executionTimeoutMs": 300000,
        "onTimeout": "fail"
      },
      "requiresApproval": true,
      "qualityGates": [],
      "metadata": {
        "ownedPaths": [
          "README.md"
        ],
        "forbiddenPaths": [
          ".bflow",
          "node_modules",
          ".git"
        ],
        "requiredCapabilities": [
          "implementation"
        ]
      }
    }
  ],
  "dependencies": [],
  "qualityGates": [],
  "maxConcurrency": 2,
  "failurePolicy": "fail-fast",
  "recovery": {
    "checkpoint": "task-boundary",
    "resumeStrategy": "checkpoint-then-replay",
    "staleExecution": "reconcile"
  }
}
