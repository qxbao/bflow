{
  "name": "ai-flow-sdlc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Module-first orchestration contracts and package boundaries for AI Flow SDLC.",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm run build && vitest run",
    "test:watch": "vitest",
    "check:deps": "node scripts/check-dependency-graph.mjs",
    "check": "pnpm run check:deps && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
