{
  "schemaVersion": 1,
  "invocation": "bflow <words> [positionals] [options] --json",
  "envelope": {
    "stream": "stdout (also for failures when --json is given)",
    "shape": "{ ok, command, exitCode, result: CommandExecutionResult(schemaVersion 3) }",
    "output": "result.output = { schemaVersion: 1, command, outcome, ids, replayed, steps[], data }"
  },
  "exitCodes": {
    "0": "SUCCESS",
    "1": "FAILED",
    "2": "USAGE",
    "3": "NOT_READY",
    "4": "NOT_FOUND",
    "5": "PERMISSION_REQUIRED",
    "6": "CONFLICT",
    "7": "UNKNOWN_STATE"
  },
  "commonFlags": [
    {
      "name": "--json",
      "type": "boolean",
      "required": false,
      "repeatable": false
    },
    {
      "name": "--help",
      "type": "boolean",
      "required": false,
      "repeatable": false
    },
    {
      "name": "--correlation-id",
      "type": "string",
      "required": false,
      "repeatable": false
    },
    {
      "name": "--idempotency-key",
      "type": "string",
      "required": false,
      "repeatable": false
    }
  ],
  "commands": [
    {
      "name": "repo.inspect",
      "usage": "bflow repo inspect",
      "summary": "Inspect repository, Git, worktrees, project structure and context",
      "mutates": "none",
      "retry": "read_only",
      "permissionFlags": [],
      "outcomes": [
        "inspected",
        "failed"
      ],
      "positionals": [],
      "flags": []
    },
    {
      "name": "task.preview",
      "usage": "bflow task preview",
      "summary": "Explain the current execution plan from read-only snapshots",
      "mutates": "none",
      "retry": "read_only",
      "permissionFlags": [],
      "outcomes": [
        "preview",
        "not_ready",
        "failed"
      ],
      "positionals": [],
      "flags": [
        {
          "name": "--run",
          "type": "string",
          "required": false,
          "repeatable": false
        },
        {
          "name": "--compare",
          "type": "string",
          "required": false,
          "repeatable": false
        }
      ]
    },
    {
      "name": "handover.inspect",
      "usage": "bflow handover inspect",
      "summary": "Show a run's snapshot identity, integrated revision and handover eligibility (read-only)",
      "mutates": "none",
      "retry": "read_only",
      "permissionFlags": [],
      "outcomes": [
        "inspected",
        "failed"
      ],
      "positionals": [],
      "flags": [
        {
          "name": "--run",
          "type": "string",
          "required": true,
          "repeatable": false
        }
      ]
    },
    {
      "name": "handover.export",
      "usage": "bflow handover export",
      "summary": "Export an offline HTML/Markdown handover package with a checksum manifest from one run snapshot",
