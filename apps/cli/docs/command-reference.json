        {
          "name": "--run",
          "type": "string",
          "required": true,
          "repeatable": false
        },
        {
          "name": "--revision",
          "type": "string",
          "required": false,
          "repeatable": false
        },
        {
          "name": "--snapshot",
          "type": "string",
          "required": false,
          "repeatable": false
        },
        {
          "name": "--out",
          "type": "string",
          "required": true,
          "repeatable": false
        },
        {
          "name": "--format",
          "type": "string",
          "required": false,
          "repeatable": true,
          "choices": [
            "html",
            "md"
          ]
        },
        {
          "name": "--include-evidence",
          "type": "boolean",
          "required": false,
          "repeatable": false
        },
        {
          "name": "--replace",
          "type": "boolean",
          "required": false,
          "repeatable": false
        }
      ]
    },
    {
      "name": "handover.verify",
      "usage": "bflow handover verify",
      "summary": "Verify an offline handover package's manifest, hashes, links and eligibility",
      "mutates": "none",
      "retry": "read_only",
      "permissionFlags": [],
      "outcomes": [
        "passed",
        "not_passed",
        "failed"
      ],
      "positionals": [],
      "flags": [
        {
          "name": "--package",
          "type": "string",
          "required": true,
          "repeatable": false
        }
      ]
    },
    {
      "name": "task.plan",
      "usage": "bflow task plan",
      "summary": "Create (preview/write) or check the task graph of a specification",
