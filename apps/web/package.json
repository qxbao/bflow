{
  "name": "@bflow/web",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    "./assets": {
      "types": "./dist/node/asset-path.d.ts",
      "import": "./dist/node/asset-path.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.app.json --noEmit && tsc -b tsconfig.node.json && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -b tsconfig.node.json --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@bflow/contracts": "workspace:*",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "7.9.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "tailwindcss": "4.3.3",
    "vite": "6.4.1",
    "vitest": "2.1.9"
  }
}
