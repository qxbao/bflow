      "expected": "invalid_request"
    },
    {
      "name": "missing generation",
      "base": "approval-bundle.design",
      "remove": [
        "expectedVersion.generation"
      ],
      "expected": "invalid_request"
    },
    {
      "name": "dropped target",
      "base": "approval-bundle.design",
      "remove": [
        "expectedVersion.target"
      ],
      "expected": "invalid_request"
    },
    {
      "name": "dropped evidence digest",
      "base": "approval-bundle.design",
      "remove": [
        "expectedVersion.evidenceDigest"
      ],
      "expected": "invalid_request"
    },
    {
      "name": "same key different body",
      "base": "validCreate",
      "set": {
        "objective": "Different objective"
      },
      "expected": "operation_conflict after durable acceptance"
