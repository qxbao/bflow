{
  "status": "W00 accepted schema vectors; stateful conflict/staleness checks belong to W02",
  "validCreate": {
    "apiVersion": 1,
    "commandId": "00000000-0000-4000-8000-000000000004",
    "projectId": "fixture-project",
    "kind": "create_request",
    "title": "Add a bounded status view",
    "requestKind": "feature",
    "objective": "Show the current workflow state without creating authority.",
    "acceptanceCriteria": [
      {
        "description": "Read shows the authoritative run status.",
        "verificationMethod": "integration_test"
      }
    ],
    "constraints": [
      "No mutation on read."
    ]
  },
  "invalidCases": [
    {
      "name": "unknown HTTP version",
      "base": "validCreate",
